# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows CMD)
#
# DO NOT commit your real .env — it is gitignored. This template is committed,
# so it must never contain real keys or passwords.
#
# Where things run:
#   Development  → Docker Compose (local Postgres container), files on disk.
#   Staging      → Render web service + Render Postgres, files in Cloudflare R2.

# ---------------------------------------------------------------------------
# DATABASE_URL controls which database Django's ORM connects to.
# ---------------------------------------------------------------------------

# Development — Docker Compose:
#   You do NOT need to set this for the app itself. docker-compose.yml injects
#   the Postgres URL for the `web` container automatically. This .env is only
#   read when you run manage.py on your HOST against the Docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vintazk360

# Staging — Render Postgres.
# Render Dashboard → your Postgres instance → "Connections":
#   - Deploying on Render? Use the INTERNAL Database URL. It stays on Render's
#     private network, is faster, and does not count against bandwidth. If you
#     deploy with render.yaml, Render injects it for you and you never copy it.
#   - Connecting from your laptop or any host outside Render (psql, a GUI, a
#     one-off migrate)? Use the EXTERNAL Database URL instead — the internal
#     hostname does not resolve off Render.
# Leave this COMMENTED here so development can never drift onto staging.
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxxxxxxxxx-a.singapore-postgres.render.com/vintazk360

# Force SSL on/off (`require` / `disable`). Auto-detected by default: off for
# localhost / the `db` container, on for any remote host such as Render.
# DATABASE_SSL=

# ---------------------------------------------------------------------------
# Cloudflare R2 — object storage for uploaded KPI import files.
#
# A SEPARATE channel from DATABASE_URL: the ORM talks to Postgres, these reach
# R2 over the S3 API. Read by apps/core/storage.py. Leave blank to run with
# storage disabled (the client then refuses to build); staging REQUIRES them.
#
# Where each value comes from (Cloudflare Dashboard → R2 Object Storage):
#   R2_ACCOUNT_ID         R2 Overview page, right-hand sidebar → "Account ID".
#                         Also the first part of the S3 API endpoint shown as
#                         https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   R2_BUCKET             The bucket you created — keep it PRIVATE (do not
#                         enable a public r2.dev URL or public custom domain).
#   R2_ACCESS_KEY_ID      R2 → API → "Manage API tokens" → Create Account API
#   R2_SECRET_ACCESS_KEY  token, permission "Object Read & Write", scoped to
#                         that one bucket. The secret is shown ONCE — copy it
#                         immediately.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vintazk360-imports

# Optional tuning.
# R2_ENDPOINT_URL=          # only for jurisdiction-specific endpoints (EU/FedRAMP)
# R2_TIMEOUT=10             # seconds
# R2_SIGNED_URL_TTL=300     # how long a download link stays valid, in seconds

# Check the wiring at any time:
#   docker compose exec web python manage.py storage_status
#   docker compose exec web python manage.py storage_status --ping

# ---------------------------------------------------------------------------
# Django — required for staging / production only. Development falls back to
# DEBUG=True, permissive hosts and an insecure SECRET_KEY.
#
# On Render: set these in the service's Environment tab (or let render.yaml
# generate SECRET_KEY). ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS are derived
# automatically from Render's RENDER_EXTERNAL_HOSTNAME — set them by hand only
# when a custom domain is attached.
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.dev   # dev | staging | prod
# SECRET_KEY=
# ALLOWED_HOSTS=staging.example.com
# CSRF_TRUSTED_ORIGINS=https://staging.example.com
