# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows CMD)
#
# DO NOT commit your real .env — it is gitignored. This template is committed,
# so it must never contain real keys or passwords.

# ---------------------------------------------------------------------------
# DATABASE_URL controls which database Django's ORM connects to.
#
# Development is Docker-only (local Postgres). Staging/production point at
# Supabase Postgres.
# ---------------------------------------------------------------------------

# Development — Docker Compose:
#   You do NOT need to set this for the app itself. docker-compose.yml injects
#   the Postgres URL for the `web` container automatically. This .env is only
#   read when you run manage.py on your HOST against the Docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vintazk360

# Staging / production — Supabase Postgres via the SESSION POOLER.
# Copy it from Supabase → Project Settings → Database → Connection string.
#
#   - Use the pooler host, NOT `db.<ref>.supabase.co`: the direct host is
#     IPv6-only and unreachable from Docker and most hosting providers.
#   - Port 5432 on the pooler = session mode, which supports the prepared
#     statements Django's psycopg driver relies on. Port 6543 is transaction
#     mode and needs extra Django configuration.
#   - Percent-encode special characters in the password (`@` → `%40`,
#     `#` → `%23`, `/` → `%2F`) so they aren't parsed as URL syntax.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Force SSL on/off (`require` / `disable`). Auto-detected by default: off for
# localhost / the `db` container, on for any remote host such as Supabase.
# DATABASE_SSL=

# ---------------------------------------------------------------------------
# Supabase HTTP API (PostgREST / Auth / Storage / Realtime).
#
# This is a SEPARATE channel from DATABASE_URL — the ORM talks to Postgres,
# these talk to the Supabase API over HTTPS. Read by apps/core/supabase.py.
# Leave blank to run with Supabase disabled (the client then refuses to build).
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bypasses Row Level Security — SERVER-SIDE ONLY, never expose to a browser.
# Only needed once a feature requires privileged access.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional client tuning.
# SUPABASE_SCHEMA=public
# SUPABASE_TIMEOUT=10

# ---------------------------------------------------------------------------
# Django — required for staging / production only. Development falls back to
# DEBUG=True, permissive hosts and an insecure SECRET_KEY.
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.dev   # dev | staging | prod
# SECRET_KEY=
# ALLOWED_HOSTS=staging.example.com
# CSRF_TRUSTED_ORIGINS=https://staging.example.com
