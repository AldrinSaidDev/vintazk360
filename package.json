{
  "name": "vintazk360",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend build tooling (Tailwind CSS) for the Vintazk 360 Django project.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/css/output.css --watch"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "chart.js": "^4.5.1",
    "font-awesome": "^4.7.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.14"
  }
}
